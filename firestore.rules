rules_version = '2';

// StripeRide pickups. Paste into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with a verified Middlesex (@mxschool.edu) Google account.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@mxschool[.]edu$');
    }

    match /pickups/{id} {
      // Signed-in students can see the day's list, like the pad on the shuttle.
      allow read: if signedIn();

      // Students add their own pickup only, with exactly these fields.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'stop', 'date', 'time', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.stop in ['stop1', 'stop2']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.createdAt == request.time;

      // Students can cancel (delete) their own pickups. Nobody edits in place.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
